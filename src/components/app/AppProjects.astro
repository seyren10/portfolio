---
import AppBadge from "@/components/app/AppBadge.astro"
import ExpressIcon from "@/assets/express-svgrepo-com.svg"
import MySqlIcon from "@/assets/mysql-logo-svgrepo-com.svg"
import MongoDbIcon from "@/assets/mongo-svgrepo-com.svg"
import NodeJsIcon from "@/assets/nodejs-logo-svgrepo-com.svg"
import LaravelIcon from "@/assets/laravel-svgrepo-com.svg"
import ReactJsIcon from "@/assets/react.svg"
import ReactRouterIcon from "@/assets/react-router-svgrepo-com.svg"
import ReduxIcon from "@/assets/Redux.svg"
import RedisIcon from "@/assets/Redis.svg"
import VuejsIcon from "@/assets/vuejs.svg"
import PiniaIcon from "@/assets/pinia.svg"
import SocketIOIcon from "@/assets/Socket.io.svg"
import NginxIcon from "@/assets/nginx.svg"
import VuetifyIcon from "@/assets/brand-vuetify-svgrepo-com.svg"
import TypeScriptIcon from "@/assets/typescript-icon-svgrepo-com.svg"
import TailwindCssIcon from "@/assets/tailwind-css.svg"
import TanStackIcon from "@/assets/tanstack.svg"
import { Button } from "@/components/ui/button"
import { Github, Share04Icon } from "@hugeicons/core-free-icons"
import { HugeiconsIcon } from "@hugeicons/react"
import { ServifiLinks } from "@/components/ServifiLinks"
import { AMSGallery } from "@/components/AMSGallery"
import { ServifiGallery } from "@/components/ServifiGallery"
import { PuyoGallery } from "@/components/PuyoGallery"
---

<section id="projects" class="scroll-m-20 px-4 md:px-0">
  <div class="container mx-auto max-w-4xl space-y-10 py-24">
    <div class="grid gap-10 md:grid-cols-[auto_1fr] md:gap-16">
      <p
        class="font-mono text-xs tracking-widest text-muted-foreground uppercase"
        data-reveal="left"
      >
        Work
      </p>
      <h2
        class="max-w-2xl text-3xl font-bold text-balance md:text-4xl"
        data-reveal="bottom"
      >
        Projects
      </h2>
    </div>

    <ul class="space-y-6" data-stagger="200">
      <li class="border border-border bg-card" data-reveal="bottom">
        <div class="grid gap-6 p-6 md:grid-cols-[1fr_20rem] md:p-8">
          <div class="order-2 space-y-4 md:order-1">
            <div>
              <p
                class="font-mono text-xs tracking-widest text-muted-foreground uppercase"
              >
                01 &middot; Fintech / ROSCA platform
              </p>
              <h3 class="mt-1 text-2xl font-bold">Puyo</h3>
              <p class="mt-1 text-muted-foreground">
                A full-stack app for running a paluwagan (ROSCA), replacing the
                group chat and notebook tracking most organizers rely on with
                one place to manage members, contributions, and payout rounds.
              </p>
            </div>
            <div class="space-y-2">
              <p class="text-sm font-semibold">Key Features</p>
              <ul
                class="ml-4 list-disc space-y-1 text-sm text-muted-foreground marker:text-primary"
              >
                <li>
                  Auto-generated payout rounds and drag-and-drop member ordering
                </li>
                <li>
                  Per-member ledger with running balance and a
                  headless-Chrome-rendered PDF export
                </li>
                <li>
                  Co-manage groups with other trusted people via share requests
                  and a per-group activity feed
                </li>
                <li>
                  Automated email reminders for members with an upcoming cycle
                  payment
                </li>
              </ul>
            </div>
            <div class="flex flex-wrap items-center gap-2.5">
              <AppBadge src={LaravelIcon} alt="Laravel">Laravel</AppBadge>
              <AppBadge src={MySqlIcon} alt="MySQL">MySQL</AppBadge>
              <AppBadge src={RedisIcon} alt="Redis">Redis</AppBadge>
              <AppBadge src={NginxIcon} alt="Nginx">Nginx</AppBadge>
              <AppBadge src={VuejsIcon} alt="Vue.js">Vue.js</AppBadge>
              <AppBadge src={TypeScriptIcon} alt="TypeScript"
                >TypeScript</AppBadge
              >
              <AppBadge src={PiniaIcon} alt="Pinia.js">Pinia.js</AppBadge>
              <AppBadge src={TanStackIcon} alt="TanStack Query"
                >TanStack Query</AppBadge
              >
              <AppBadge src={TailwindCssIcon} alt="Tailwind CSS"
                >Tailwind CSS</AppBadge
              >
            </div>
          </div>
          <div class="order-1 overflow-hidden border border-border md:order-2">
            <PuyoGallery client:load />
          </div>
        </div>

        <hr class="border-border" />
        <div class="flex flex-wrap items-center gap-4 p-6 md:p-8">
          <a
            href="https://puyo.rvgagarin.xyz"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Button client:visible>
              <HugeiconsIcon icon={Share04Icon} className="size-4" />
              Live Site
            </Button>
          </a>
          <a
            href="https://github.com/seyren10/puyo"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Button client:visible variant="outline">
              <HugeiconsIcon icon={Github} className="size-4" />
              View Code
            </Button>
          </a>
        </div>

        <div class="flex flex-col gap-2 p-6 md:p-8">
          <p class="text-muted-foreground text-sm">Upvote my app</p>
          <iframe
            src="https://appbuildersph.com/embed/apps/puyo"
            title="Puyo votes on App Builders PH"
            width="320"
            height="72"
            style="border:0"
            loading="lazy"
            scrolling="no"></iframe>
        </div>
      </li>

      <li class="border border-border bg-card" data-reveal="bottom">
        <div class="grid gap-6 p-6 md:grid-cols-[1fr_20rem] md:p-8">
          <div class="order-2 space-y-4 md:order-1">
            <div>
              <p
                class="font-mono text-xs tracking-widest text-muted-foreground uppercase"
              >
                02 &middot; Internal tooling
              </p>
              <h3 class="mt-1 text-2xl font-bold">Asset Management System</h3>
              <p class="mt-1 text-muted-foreground">
                A web-based system developed to manage and track company assets
                such as laptops, PCs, and tablets.
              </p>
            </div>
            <div class="space-y-2">
              <p class="text-sm font-semibold">Key Features</p>
              <ul
                class="ml-4 list-disc space-y-1 text-sm text-muted-foreground marker:text-primary"
              >
                <li>Tracks asset assignment to employees</li>
                <li>Maintains history of previous asset ownership</li>
                <li>
                  Displays asset details including department and location
                </li>
                <li>Provides centralized management of company devices</li>
              </ul>
            </div>
            <div class="flex flex-wrap items-center gap-2.5">
              <AppBadge src={LaravelIcon} alt="Laravel">Laravel</AppBadge>
              <AppBadge src={MySqlIcon} alt="MySQL">MySQL</AppBadge>
              <AppBadge src={VuejsIcon} alt="Vue.js">Vue.js</AppBadge>
              <AppBadge src={VuetifyIcon} alt="Vuetify UI">Vuetify UI</AppBadge>
              <AppBadge src={PiniaIcon} alt="Pinia.js">Pinia.js</AppBadge>
            </div>
          </div>
          <div class="order-1 overflow-hidden border border-border md:order-2">
            <AMSGallery client:load />
          </div>
        </div>

        <hr class="border-border" />
        <div class="p-6 md:p-8">
          <a
            href="https://github.com/seyren10/mkta-EIS"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Button client:visible variant="outline">
              <HugeiconsIcon icon={Github} className="size-4" />
              View Code
            </Button>
          </a>
        </div>
      </li>

      <li class="border border-border bg-card" data-reveal="bottom">
        <div class="grid gap-6 p-6 md:grid-cols-[1fr_20rem] md:p-8">
          <div class="order-2 space-y-4 md:order-1">
            <div>
              <p
                class="font-mono text-xs tracking-widest text-muted-foreground uppercase"
              >
                03 &middot; Restaurant tech
              </p>
              <h3 class="mt-1 text-2xl font-bold">Servifi</h3>
              <p class="mt-1 text-muted-foreground">
                A restaurant management system designed for Korean BBQ
                restaurants offering unlimited dining, featuring QR-based
                ordering and real-time table service.
              </p>
            </div>
            <div class="space-y-2">
              <p class="text-sm font-semibold">Key Features</p>
              <ul
                class="ml-4 list-disc space-y-1 text-sm text-muted-foreground marker:text-primary"
              >
                <li>QR code-based ordering system for customers</li>
                <li>
                  Real-time order updates and table service requests (e.g. call
                  waiter, bill out)
                </li>
                <li>Table management system</li>
                <li>Food and category management</li>
                <li>Dashboard with insights such as most ordered items</li>
              </ul>
            </div>
            <div class="flex flex-wrap items-center gap-2.5">
              <AppBadge src={NodeJsIcon} alt="Node.js">Node.js</AppBadge>
              <AppBadge src={ExpressIcon} alt="Express.js">Express.js</AppBadge>
              <AppBadge src={RedisIcon} alt="Redis">Redis</AppBadge>
              <AppBadge src={MongoDbIcon} alt="MongoDB">MongoDB</AppBadge>
              <AppBadge src={SocketIOIcon} alt="Socket.io">Socket.io</AppBadge>
              <AppBadge src={ReactJsIcon} alt="React.js">React.js</AppBadge>
              <AppBadge src={ReactRouterIcon} alt="React Router"
                >React Router</AppBadge
              >
              <AppBadge src={ReduxIcon} alt="Redux">Redux</AppBadge>
            </div>
          </div>
          <div
            class="order-1 aspect-square overflow-hidden border border-border md:order-2"
          >
            <ServifiGallery client:load />
          </div>
        </div>

        <hr class="border-border" />
        <div class="flex flex-wrap items-center gap-4 p-6 md:p-8">
          <ServifiLinks client:load />
          <a
            href="https://servifi-app.vercel.app/admin/signin"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Button client:visible>
              <HugeiconsIcon icon={Share04Icon} className="size-4" />
              Live Demo
            </Button>
          </a>
          <div
            class="inline-flex flex-wrap gap-3 border border-border px-3 py-2 font-mono text-xs text-muted-foreground"
          >
            <span
              >user: <span class="text-foreground">test@example.com</span></span
            >
            <span>pass: <span class="text-foreground">password</span></span>
          </div>
        </div>
      </li>
    </ul>
  </div>
</section>
