---
import { Call02Icon, Email, Location } from "@hugeicons/core-free-icons"
import { HugeiconsIcon } from "@hugeicons/react"
import { Button } from "@/components/ui/button"

const channels = [
  {
    icon: Email,
    label: "Email",
    value: "gagarinroyvictor@gmail.com",
    href: "mailto:gagarinroyvictor@gmail.com",
  },
  {
    icon: Call02Icon,
    label: "Phone",
    value: "(+63) 956 304 0025",
    href: "tel:+639563040025",
  },
  {
    icon: Location,
    label: "Location",
    value: "San Nicolas, Victoria, Tarlac, PH",
    href: null,
  },
]
---

<section id="contact" class="scroll-m-20 px-4 md:px-0">
  <div class="container mx-auto max-w-4xl space-y-14 py-24">
    <div class="grid gap-10 md:grid-cols-[auto_1fr] md:gap-16">
      <p
        class="font-mono text-xs tracking-widest text-muted-foreground uppercase"
        data-reveal="left"
      >
        Contact
      </p>
      <h2
        class="max-w-2xl text-3xl font-bold text-balance md:text-4xl"
        data-reveal="bottom"
      >
        Get In Touch
      </h2>
    </div>

    <ul
      class="grid divide-y divide-border border-y border-border sm:grid-cols-3 sm:divide-x sm:divide-y-0"
      data-stagger="150"
    >
      {
        channels.map((channel) => (
          <li
            class="space-y-3 py-6 sm:px-6 first:sm:pl-0 last:sm:pr-0"
            data-reveal="bottom"
          >
            <div class="flex items-center gap-2 text-muted-foreground">
              <HugeiconsIcon icon={channel.icon} className="size-4" />
              <span class="font-mono text-xs tracking-widest uppercase">
                {channel.label}
              </span>
            </div>
            {channel.href ? (
              <a
                href={channel.href}
                class="block font-semibold break-words text-foreground transition-colors hover:text-primary"
              >
                {channel.value}
              </a>
            ) : (
              <span class="block font-semibold break-words">
                {channel.value}
              </span>
            )}
          </li>
        ))
      }
    </ul>

    <div
      class="relative isolate space-y-5 bg-primary p-8 text-primary-foreground md:p-16"
      data-reveal="bottom"
      data-delay="200"
    >
      <h3 class="max-w-xl text-3xl font-bold text-balance md:text-5xl">
        Ready to build something amazing?
      </h3>
      <p
        class="max-w-[60ch] text-base leading-relaxed text-balance opacity-80 md:text-lg"
      >
        I'm always open to discussing new projects, creative ideas or
        opportunities to be part of your vision.
      </p>
      <div class="flex flex-wrap items-center gap-4 pt-2">
        <a href="mailto:gagarinroyvictor@gmail.com">
          <Button
            client:visible
            size="lg"
            className="bg-background text-foreground hover:bg-background/85"
          >
            Send me an email
          </Button>
        </a>
        <a href="/Roy_Victor_Gagarin_CV.pdf" download>
          <Button
            client:visible
            size="lg"
            variant="outline"
            className="border-primary-foreground/30 bg-transparent text-primary-foreground hover:bg-primary-foreground/10"
          >
            Download CV
          </Button>
        </a>
      </div>
    </div>
  </div>
</section>
