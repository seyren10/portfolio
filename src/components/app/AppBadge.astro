---
import { Image } from "astro:assets"
const { src, alt } = Astro.props
---

<span
  class="inline-flex items-center gap-1.5 border border-border bg-card px-2.5 py-1 font-mono text-xs text-muted-foreground transition-colors hover:border-primary/50 hover:text-foreground"
>
  {src && alt && <Image src={src} alt={alt} class="size-3.5 object-contain" />}
  <slot />
</span>
