---
const stats = [
  {
    value: "2+",
    label: "Years experience",
    note: "Building modern web applications",
  },
  {
    value: "5+",
    label: "Projects completed",
    note: "Companies and personal projects",
  },
  { value: "6+", label: "Core stack", note: "Full-stack technologies" },
]
---

<section id="about" class="scroll-m-20 px-4 md:px-0">
  <div class="container mx-auto max-w-4xl space-y-10 py-24">
    <div class="space-y-6">
      <h2
        class="max-w-2xl text-3xl font-bold text-balance md:text-4xl"
        data-reveal="bottom"
      >
        A full-stack developer who likes making messy workflows simple.
      </h2>
      <p
        class="max-w-2xl text-lg leading-relaxed text-muted-foreground"
        data-reveal="bottom"
      >
        I'm a Full-Stack Web Developer with 2+ years of experience building
        web-based systems and applications. I mainly work with Laravel and
        Node.js on the backend, and Vue and React on the frontend.
      </p>
      <p
        class="max-w-2xl text-lg leading-relaxed text-muted-foreground"
        data-reveal="bottom"
      >
        I enjoy building internal tools and RESTful APIs that simplify
        workflows and solve real-world problems, and I continuously improve my
        skills by working with modern technologies and practical use cases.
      </p>
    </div>

    <dl
      class="grid divide-y divide-border border-y border-border sm:grid-cols-3 sm:divide-x sm:divide-y-0"
      data-reveal="bottom"
      data-delay="200"
    >
      {
        stats.map((stat) => (
          <div class="space-y-1 py-6 sm:px-6 first:sm:pl-0 last:sm:pr-0">
            <dt class="font-mono text-4xl font-bold text-primary tabular-nums md:text-5xl">
              {stat.value}
            </dt>
            <dd class="text-sm font-semibold">{stat.label}</dd>
            <dd class="text-sm text-muted-foreground">{stat.note}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>