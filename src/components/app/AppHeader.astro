---
import { ModeToggle } from "@/components/ModeToggle"
import { Button } from "@/components/ui/button"

const links = [
  { label: "Projects", href: "#projects" },
  { label: "Experience", href: "#work-experience" },
  { label: "Skills", href: "#skills" },
  { label: "About", href: "#about" },
  { label: "Contact", href: "#contact" },
]
---

<header
  id="app-header"
  class="fixed top-0 z-50 w-full border-b border-transparent px-4 transition-colors duration-300"
>
  <nav
    class="container mx-auto flex items-center justify-between border-b border-border/0 py-4"
  >
    <!-- Logo -->
    <a
      href="#"
      class="flex shrink-0 items-center gap-2 transition-opacity hover:opacity-70"
      aria-label="Roy Victor home"
    >
      <img src="/logo.svg" alt="Roy Victor" class="size-7 md:size-8" />
      <span
        class="hidden font-mono text-xs tracking-wider text-muted-foreground uppercase sm:inline"
        >Roy Gagarin</span
      >
    </a>

    <!-- Desktop Nav Links -->
    <ul class="hidden items-center gap-1 md:flex" role="list">
      {
        links.map(({ label, href }, i) => (
          <li>
            <a
              href={href}
              class="nav-link group relative flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-muted-foreground transition-colors duration-200 hover:text-foreground"
            >
              <span class="font-mono text-[0.65rem] text-muted-foreground/60 tabular-nums group-hover:text-primary">
                {String(i + 1).padStart(2, "0")}
              </span>
              {label}
              <span class="nav-underline absolute inset-x-3 -bottom-px h-px scale-x-0 bg-primary transition-transform duration-300" />
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Right side: ModeToggle + CV Button + Hamburger -->
    <div class="flex shrink-0 items-center gap-3">
      <ModeToggle client:load />

      <a href="/Roy_Victor_Gagarin_CV.pdf" download class="hidden md:block">
        <Button
          client:load
          tabIndex={0}
          className="font-mono text-xs tracking-wide uppercase"
        >
          Download CV
        </Button>
      </a>

      <!-- Hamburger button (mobile only) -->
      <button
        id="hamburger-btn"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="relative flex size-9 flex-col items-center justify-center gap-1.25 border border-border bg-card transition-colors hover:border-primary md:hidden"
      >
        <span
          class="hamburger-line block h-px w-5 bg-foreground transition-all duration-300 ease-in-out"
        ></span>
        <span
          class="hamburger-line block h-px w-5 bg-foreground transition-all duration-300 ease-in-out"
        ></span>
        <span
          class="hamburger-line block h-px w-5 bg-foreground transition-all duration-300 ease-in-out"
        ></span>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu Drawer -->
  <div
    id="mobile-menu"
    role="menu"
    aria-label="Mobile navigation"
    class="mobile-menu-closed overflow-hidden border-t border-border/60 md:hidden"
  >
    <ul class="container mx-auto flex flex-col gap-1 py-4" role="list">
      {
        links.map(({ label, href }, i) => (
          <li>
            <a
              href={href}
              role="menuitem"
              class="mobile-nav-link flex items-center gap-3 px-3 py-3 text-sm font-medium text-muted-foreground transition-colors duration-150 hover:bg-accent hover:text-foreground"
              style={`--delay: ${i * 40}ms`}
            >
              <span class="font-mono text-[0.65rem] text-muted-foreground/60 tabular-nums">
                {String(i + 1).padStart(2, "0")}
              </span>
              {label}
            </a>
          </li>
        ))
      }

      <li class="mt-3 border-t border-border/60 pt-3">
        <a href="/Roy_Victor_Gagarin_CV.pdf" download class="block w-full">
          <Button
            client:load
            className="w-full font-mono text-xs tracking-wide uppercase"
            tabIndex={0}
          >
            Download CV
          </Button>
        </a>
      </li>
    </ul>
  </div>
</header>

<style>
  /* Mobile menu states */
  .mobile-menu-closed {
    max-height: 0;
    opacity: 0;
    transition:
      max-height 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.25s ease;
  }

  .mobile-menu-open {
    max-height: 500px;
    opacity: 1;
    transition:
      max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.25s ease;
  }

  /* Staggered item reveal when menu opens */
  .mobile-menu-open .mobile-nav-link {
    animation: slide-in 0.25s ease both;
    animation-delay: var(--delay, 0ms);
  }

  @keyframes slide-in {
    from {
      opacity: 0;
      transform: translateX(-8px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* Hamburger → X transformation */
  :global([aria-expanded="true"]) .hamburger-line:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  :global([aria-expanded="true"]) .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  :global([aria-expanded="true"]) .hamburger-line:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* Active + hover nav link underline */
  :global(.nav-link:hover) .nav-underline {
    transform: scaleX(1);
  }
  :global(.nav-link.active) {
    color: var(--foreground);
  }
  :global(.nav-link.active) .nav-underline {
    transform: scaleX(1);
  }

  /* Header chrome on scroll */
  :global(.header-scrolled) {
    border-bottom-color: var(--border);
    background-color: color-mix(in oklab, var(--background) 88%, transparent);
    backdrop-filter: blur(10px);
  }

  @media (max-width: 767px) {
    :global(#app-header) {
      background-color: color-mix(in oklab, var(--background) 88%, transparent);
      backdrop-filter: blur(10px);
      border-bottom-color: var(--border);
    }
  }
</style>

<script>
  const header = document.getElementById("app-header")
  const hamburgerBtn = document.getElementById("hamburger-btn")
  const mobileMenu = document.getElementById("mobile-menu")
  const mobileLinks = mobileMenu?.querySelectorAll("a[href^='#']")
  const desktopLinks = document.querySelectorAll(".nav-link")

  // --- Hamburger toggle ---
  hamburgerBtn?.addEventListener("click", () => {
    const isOpen = hamburgerBtn.getAttribute("aria-expanded") === "true"
    hamburgerBtn.setAttribute("aria-expanded", String(!isOpen))
    mobileMenu?.classList.toggle("mobile-menu-closed", isOpen)
    mobileMenu?.classList.toggle("mobile-menu-open", !isOpen)
  })

  // Close mobile menu on link click
  mobileLinks?.forEach((link) => {
    link.addEventListener("click", () => {
      hamburgerBtn?.setAttribute("aria-expanded", "false")
      mobileMenu?.classList.add("mobile-menu-closed")
      mobileMenu?.classList.remove("mobile-menu-open")
    })
  })

  // Close mobile menu when clicking outside
  document.addEventListener("click", (e) => {
    if (
      hamburgerBtn &&
      mobileMenu &&
      !hamburgerBtn.contains(e.target as Node) &&
      !mobileMenu.contains(e.target as Node)
    ) {
      hamburgerBtn.setAttribute("aria-expanded", "false")
      mobileMenu.classList.add("mobile-menu-closed")
      mobileMenu.classList.remove("mobile-menu-open")
    }
  })

  // --- Scroll shadow ---
  window.addEventListener("scroll", () => {
    header?.classList.toggle("header-scrolled", window.scrollY > 10)
  })

  // --- Active section highlighting ---
  const sectionIds = [
    "projects",
    "work-experience",
    "skills",
    "about",
    "contact",
  ]

  const observerOptions: IntersectionObserverInit = {
    root: null,
    rootMargin: "-40% 0px -55% 0px",
    threshold: 0,
  }

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const id = entry.target.getAttribute("id")
        desktopLinks.forEach((link) => {
          const href = link.getAttribute("href")
          link.classList.toggle("active", href === `#${id}`)
        })
      }
    })
  }, observerOptions)

  sectionIds.forEach((id) => {
    const el = document.getElementById(id)
    if (el) observer.observe(el)
  })
</script>
