---
import {
  GithubIcon,
  Linkedin02Icon,
  Mail01Icon,
} from "@hugeicons/core-free-icons"
import { HugeiconsIcon } from "@hugeicons/react"

const currentYear = new Date().getFullYear()
---

<footer class="border-t border-border">
  <div class="container mx-auto max-w-4xl px-4 py-16">
    <div class="grid gap-12 md:grid-cols-3">
      <!-- Left Column -->
      <div>
        <h3 class="text-lg font-bold">Roy Victor Gagarin</h3>
        <p
          class="mt-1 font-mono text-xs tracking-widest text-primary uppercase"
        >
          Full Stack Developer
        </p>
        <p class="mt-4 text-sm text-muted-foreground">
          Building functional web applications and internal tools with modern
          technologies.
        </p>
      </div>

      <!-- Middle Column -->
      <div>
        <h4
          class="font-mono text-xs tracking-widest text-muted-foreground uppercase"
        >
          Quick Links
        </h4>
        <nav class="mt-4 space-y-2">
          <a
            href="#about"
            class="block text-sm text-muted-foreground transition-colors hover:text-primary"
          >
            About
          </a>
          <a
            href="#skills"
            class="block text-sm text-muted-foreground transition-colors hover:text-primary"
          >
            Skills
          </a>
          <a
            href="#projects"
            class="block text-sm text-muted-foreground transition-colors hover:text-primary"
          >
            Projects
          </a>
          <a
            href="#work-experience"
            class="block text-sm text-muted-foreground transition-colors hover:text-primary"
          >
            Work Experience
          </a>
        </nav>
      </div>

      <!-- Right Column -->
      <div>
        <h4
          class="font-mono text-xs tracking-widest text-muted-foreground uppercase"
        >
          Connect
        </h4>
        <div class="mt-4 flex gap-3">
          <a
            href="https://github.com/seyren10"
            target="_blank"
            class="flex size-10 items-center justify-center border border-border text-muted-foreground transition-colors hover:border-primary hover:text-primary"
            aria-label="GitHub"
          >
            <HugeiconsIcon icon={GithubIcon} className="size-4" />
          </a>
          <a
            href="https://www.linkedin.com/in/roy-gagarin-38b790261"
            target="_blank"
            aria-label="LinkedIn"
            class="flex size-10 items-center justify-center border border-border text-muted-foreground transition-colors hover:border-primary hover:text-primary"
          >
            <HugeiconsIcon icon={Linkedin02Icon} className="size-4" />
          </a>
          <a
            href="mailto:gagarinroyvictor@gmail.com"
            aria-label="email"
            class="flex size-10 items-center justify-center border border-border text-muted-foreground transition-colors hover:border-primary hover:text-primary"
          >
            <HugeiconsIcon icon={Mail01Icon} className="size-4" />
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Section -->
    <div
      class="mt-12 flex flex-col justify-between gap-2 border-t border-border pt-8 font-mono text-xs text-muted-foreground md:flex-row"
    >
      <p>&copy; {currentYear} Roy Victor Gagarin. All rights reserved.</p>
      <p>Crafted with care and modern web technologies</p>
    </div>
  </div>
</footer>
