---
import AppBadge from "@/components/app/AppBadge.astro"
import VueJsIcon from "@/assets/vuejs.svg"
import ReactJsIcon from "@/assets/react.svg"
import PiniaIcon from "@/assets/pinia.svg"
import ReactRouterIcon from "@/assets/react-router-svgrepo-com.svg"
import TanstackIcon from "@/assets/tanstack.png"
import JavascriptIcon from "@/assets/javascript-logo-svgrepo-com.svg"
import TypescriptIcon from "@/assets/typescript-icon-svgrepo-com.svg"
import CssIcon from "@/assets/css3-svgrepo-com.svg"
import HtmlIcon from "@/assets/html-5-svgrepo-com.svg"
import TailwindIcon from "@/assets/tailwind-css.svg"
import ShadcnIcon from "@/assets/shadcn-icon.png"
import VuetifyIcon from "@/assets/brand-vuetify-svgrepo-com.svg"
import AstroIcon from "@/assets/Astro.svg"
import LaravelIcon from "@/assets/laravel-svgrepo-com.svg"
import PhpIcon from "@/assets/PHP.svg"
import NodejsIcon from "@/assets/nodejs-logo-svgrepo-com.svg"
import ExpressIcon from "@/assets/express-svgrepo-com.svg"
import MySqlIcon from "@/assets/mysql-logo-svgrepo-com.svg"
import MongoDbIcon from "@/assets/mongo-svgrepo-com.svg"
import GitIcon from "@/assets/git-svgrepo-com.svg"
import GithubIcon from "@/assets/github-color-svgrepo-com.svg"
import DockerIcon from "@/assets/docker-svgrepo-com.svg"
import ReduxIcon from "@/assets/Redux.svg"
import RedisIcon from "@/assets/Redis.svg"
import NginxIcon from "@/assets/nginx.svg"

const groups = [
  {
    label: "Frontend",
    skills: [
      { src: VueJsIcon, alt: "Vue.js", name: "Vue.js" },
      { src: ReactJsIcon, alt: "React.js", name: "React.js" },
      { src: AstroIcon, alt: "Astro.js", name: "Astro.js" },
      { src: HtmlIcon, alt: "HTML", name: "HTML" },
      { src: CssIcon, alt: "CSS", name: "CSS" },
      { src: JavascriptIcon, alt: "JavaScript", name: "JavaScript" },
      { src: TailwindIcon, alt: "Tailwind CSS", name: "Tailwind CSS" },
      { src: TypescriptIcon, alt: "TypeScript", name: "TypeScript" },
      { src: ShadcnIcon, alt: "ShadCN UI", name: "ShadCN UI" },
      { src: VuetifyIcon, alt: "Vuetify UI", name: "Vuetify UI" },
      { src: PiniaIcon, alt: "Pinia.js", name: "Pinia.js" },
      { src: ReduxIcon, alt: "Redux", name: "Redux" },
      { src: ReactRouterIcon, alt: "React Router", name: "React Router" },
      { src: TanstackIcon, alt: "TanStack", name: "TanStack" },
    ],
  },
  {
    label: "Backend",
    skills: [
      { src: LaravelIcon, alt: "Laravel", name: "Laravel" },
      { src: PhpIcon, alt: "PHP", name: "PHP" },
      { src: NodejsIcon, alt: "Node.js", name: "Node.js" },
      { src: ExpressIcon, alt: "Express.js", name: "Express.js" },
      { src: RedisIcon, alt: "Redis", name: "Redis" },
    ],
  },
  {
    label: "Databases",
    skills: [
      { src: MySqlIcon, alt: "MySQL", name: "MySQL" },
      { src: MongoDbIcon, alt: "MongoDB", name: "MongoDB" },
    ],
  },
  {
    label: "Tools",
    skills: [
      { src: GitIcon, alt: "Git", name: "Git" },
      { src: GithubIcon, alt: "GitHub", name: "GitHub" },
      { src: DockerIcon, alt: "Docker", name: "Docker" },
      { src: NginxIcon, alt: "Nginx", name: "Nginx" },
    ],
  },
]
---

<section id="skills" class="scroll-m-20 px-4 md:px-0">
  <div class="container mx-auto max-w-4xl space-y-10 py-24">
    <div class="grid gap-10 md:grid-cols-[auto_1fr] md:gap-16">
      <p
        class="font-mono text-xs tracking-widest text-muted-foreground uppercase"
        data-reveal="left"
      >
        Skills
      </p>
      <h2
        class="max-w-2xl text-3xl font-bold text-balance md:text-4xl"
        data-reveal="bottom"
      >
        Skills &amp; Technologies
      </h2>
    </div>

    <div
      class="divide-y divide-border border-y border-border"
      data-stagger="120"
    >
      {
        groups.map((group) => (
          <div
            class="grid gap-4 py-6 md:grid-cols-[10rem_1fr] md:gap-8"
            data-reveal="bottom"
          >
            <h3 class="font-mono text-sm tracking-wide text-muted-foreground uppercase">
              {group.label}
            </h3>
            <div class="flex flex-wrap items-center gap-2.5">
              {group.skills.map((skill) => (
                <AppBadge src={skill.src} alt={skill.alt}>
                  {skill.name}
                </AppBadge>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
